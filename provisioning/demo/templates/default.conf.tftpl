# Generated by Terraform from templates/default.conf.tftpl. Do not edit inside the container.

# Docker's internal DNS. Re-check app IPs every 5s, so a recreated app (new IP) is found again.
resolver 127.0.0.11 valid=5s;

upstream apps {
    zone apps 64k;    # shared state across nginx workers; also required for "resolve"
%{ for app in apps ~}
    server ${app}:80 resolve;
%{ endfor ~}
}

server {
    listen 80;

    location / {
        proxy_pass http://apps;
        proxy_set_header Host            $host;
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
